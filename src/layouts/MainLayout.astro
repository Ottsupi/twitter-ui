---
import "../styles/global.css";
---

<!doctype html>
<html
    lang="en"
    x-data="{
        // If theme is 'system' or null, follow system theme
        // Else, follow saved theme
        isDarkMode: !('theme' in localStorage) || localStorage.getItem('theme') == 'system'
                ? window.matchMedia('(prefers-color-scheme: dark)').matches
                : localStorage.getItem('theme') == 'dark',
        theme: localStorage.getItem('theme') || 'system',
    }"
    x-init="
        // This script only supports two modes, light and dark
        console.debug(`Saved theme is ${localStorage.getItem('theme')}`);
        console.debug(`Starting theme is ${theme}`);
        console.debug(`Variable 'isDarkMode' is ${isDarkMode}`);

        // If current mode is the same as preference, follow system theme
        $watch('isDarkMode', (isDarkMode) => {
            console.debug(`Variable 'isDarkMode' is changed to ${isDarkMode}`);
            console.debug(`Previous theme is ${theme}`);
            isDarkMode && window.matchMedia('(prefers-color-scheme: dark)').matches
                ? localStorage.setItem('theme', 'system')
                : localStorage.setItem('theme', isDarkMode ? 'dark' : 'light');
            theme = localStorage.getItem('theme');
            console.debug(`Current theme is ${theme}`);
        });

        // Prioritize system preference
        window.matchMedia('(prefers-color-scheme: dark)').addListener((e) => {
            console.debug('System preferred color scheme changed. Prioritizing...');
            isDarkMode = e.matches;
        });
    "
    x-bind:class="{ 'dark': isDarkMode }"
>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="generator" content={Astro.generator} />

        <title>Twitter UI</title>

        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="stylesheet" href="" />

        <!-- Script to immediately set theme mode to prevent white flash -->
        <script is:inline>
            const isDarkModeInitial =
                !("theme" in localStorage) ||
                localStorage.getItem("theme") == "system"
                    ? window.matchMedia("(prefers-color-scheme: dark)").matches
                    : localStorage.getItem("theme") == "dark";
            isDarkModeInitial && document.documentElement.classList.add("dark");
        </script>

        <!-- Import AlpineJS -->
        <script
            is:inline
            defer
            src="https://cdn.jsdelivr.net/npm/alpinejs@3.15.0/dist/cdn.min.js"
        ></script>
    </head>
    <body class="bg-white dark:bg-black transition-colors duration-300">
        <slot>
            <div class="h-screen flex flex-row justify-center items-center">
                <span class="text-6xl">
                    <code>layouts/MainLayout.astro</code>
                </span>
            </div>
        </slot>
    </body>
</html>
